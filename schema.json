{
    "section_basic": {
        "type": "section",
        "name": "基础设置",
        "collapsed": false,
        "fields": {
            "knowledge_base_dir": {
                "name": "知识库存储目录",
                "type": "string",
                "default": null,
                "hint": "知识库文件存储的根目录（留空则使用 data/knowledge_base）"
            },
            "chunk_size": {
                "name": "分块大小（字符）",
                "type": "integer",
                "default": 500,
                "minimum": 100,
                "hint": "文档分块的字符数。"
            },
            "chunk_overlap": {
                "name": "分块重叠（字符）",
                "type": "integer",
                "default": 100,
                "minimum": 0,
                "maximum": 400,
                "hint": "相邻块之间的重叠字符数（必须小于分块大小）。"
            },
            "default_top_k": {
                "name": "默认检索结果数",
                "type": "integer",
                "default": 5,
                "minimum": 1,
                "hint": "知识库检索返回的默认文档块数量。"
            },
            "enable_hybrid_search": {
                "name": "启用混合检索（BM25 + 向量）",
                "type": "switch",
                "default": true,
                "hint": "是否启用 BM25 关键词检索与向量检索的融合。"
            },
            "enable_rerank": {
                "name": "启用重排序",
                "type": "switch",
                "default": false,
                "hint": "是否对检索结果进行重排序。重排序模型将使用 KiraAI 默认配置。"
            }
        }
    },
    "section_webui": {
        "type": "section",
        "name": "WebUI 设置",
        "collapsed": false,
        "fields": {
            "enable_webui": {
                "name": "启用独立 WebUI",
                "type": "switch",
                "default": false,
                "hint": "是否启动独立管理界面服务（默认关闭，使用侧边栏内嵌页面即可）。"
            },
            "webui_port": {
                "name": "独立 WebUI 端口",
                "type": "integer",
                "default": 19122,
                "minimum": 0,
                "maximum": 65535,
                "hint": "独立管理界面的端口（0 = 禁用）。"
            },
            "webui_host": {
                "name": "WebUI 绑定地址",
                "type": "string",
                "default": "127.0.0.1",
                "hint": "WebUI 绑定的 IP 地址，127.0.0.1 仅本机访问。"
            },
            "webui_token": {
                "name": "WebUI 访问令牌",
                "type": "string",
                "default": "",
                "hint": "独立 WebUI 的 Bearer Token（留空则无认证）。"
            }
        }
    },
    "section_permission": {
        "type": "section",
        "name": "权限设置",
        "collapsed": false,
        "fields": {
            "owner_whitelist": {
                "name": "白名单（可删改知识库的用户 ID）",
                "type": "list",
                "default": [],
                "hint": "填写允许删除/修改知识条目的用户 ID（如 QQ 号）。留空则不硬限制，由 LLM 人设判断。"
            }
        }
    }
}
